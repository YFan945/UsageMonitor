{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentMonitor",
  "version": "1.4.0",
  "identifier": "com.yfan945.agentmonitor",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "多 Agent 调用次数与 Token 用量的本地监控工具",
    "longDescription": "读取本机 Agent 会话日志，提供用量趋势、活动热力图、完整排行及模型、项目和 Agent 筛选。支持主题与监测来源设置、原生窗口和托盘；关闭窗口后监控继续运行，通过退出入口停止。用量合计不代表费用或账户剩余额度。",
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
